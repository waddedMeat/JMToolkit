{
    "name": "jmoran/jm-toolkit",
    "description": "Parses CSV files into nested arrays or objects using dot separated column headers.",
    "type": "library",
    "license": "MIT",
    "keywords": ["csv", "parser", "nested"],
    "authors": [
        {
            "name": "James Moran",
            "email": "moranjk75@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "JMToolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JMToolkit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
